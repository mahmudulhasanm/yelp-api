# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Cache Settings (seconds)
CACHE_TTL=3600
REVIEW_TTL=21600

# Optional proxy for outgoing requests to Yelp (strongly recommended for volume)
# Yelp blocks datacenter IPs aggressively — use a residential/rotating proxy.
# PROXY=http://user:pass@host:port
PROXY=

# Reviews GraphQL persisted-query hash. Yelp rotates this occasionally; if
# /reviews stops returning data, capture a fresh GetBusinessReviewFeed request
# from browser DevTools and paste its documentId here.
# YELP_REVIEW_DOC_ID=
