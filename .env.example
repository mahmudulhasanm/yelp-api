# --- Crawlbase (Crawling API) ---
# Required. Your Crawlbase token. Use the Normal token for non-JS requests.
CRAWLBASE_TOKEN=
# Optional: your Crawlbase JavaScript token (only needed if CRAWLBASE_JAVASCRIPT=true).
CRAWLBASE_JS_TOKEN=
# Optional: render pages in a real browser (needs the JS token). Yelp pages are
# server-rendered, so leave this off unless a page comes back empty.
CRAWLBASE_JAVASCRIPT=false
# Optional: geolocate the exit IP (Yelp US -> US).
CRAWLBASE_COUNTRY=US
# HTTP timeout (seconds) for Crawlbase calls.
REQUEST_TIMEOUT=90

# Reviews GraphQL persisted-query hash. Yelp rotates this occasionally; if
# /reviews stops returning data, capture a fresh GetBusinessReviewFeed request
# from browser DevTools and paste its documentId here.
# YELP_REVIEW_DOC_ID=

# --- Redis (optional) — response cache ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_TTL=3600
REVIEW_TTL=21600
