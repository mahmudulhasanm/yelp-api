# --- Bright Data Web Scraper API (prebuilt Yelp scrapers) ---
# Required. Your Bright Data API key (Account settings -> API keys).
BRIGHTDATA_API_KEY=

# Dataset IDs = the gd_... id in each scraper's URL in the Bright Data panel.
# Business scraper defaults to the public Yelp Businesses dataset:
BRIGHTDATA_YELP_BUSINESS_DATASET=gd_lgugwl0519h1p14rwk
# Reviews scraper — set this to your Yelp Reviews scraper's gd_... id:
BRIGHTDATA_YELP_REVIEWS_DATASET=

# HTTP timeout (seconds) for calls to Bright Data's API (trigger/progress are fast).
REQUEST_TIMEOUT=30

# --- Redis (optional) — job registry + result cache ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
RESULT_TTL=86400
JOB_TTL=86400
